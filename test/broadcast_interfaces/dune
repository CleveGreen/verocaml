(rule
 (targets
  integration_environment.ml
  static_elision_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{environment_module} static_elision_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (flags (:standard -I src/.verocaml_core.objs/byte))
 (libraries
  outcome_test_support
  verocaml_core
  vero_ppx_rewriter
  compiler-libs.common
  delator
  unix))

(rule
 (targets
  broadcast-interfaces-outcome-cases.result-report
  broadcast-interfaces-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  integration-library-environment.manifest)
 (action
  (run
   %{suite}
   --produce
   broadcast-interfaces-outcome-cases.result-report
   broadcast-interfaces-outcome-cases.failure-archive)))

(rule
 (alias broadcast-interfaces-outcome-check)
 (deps
  (:report broadcast-interfaces-outcome-cases.result-report)
  (:archive broadcast-interfaces-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

(alias
 (name runtest)
 (deps (alias broadcast-interfaces-outcome-check)))

(executable
 (name static_elision_cases)
 (modules static_elision_cases static_elision_environment)
 (enabled_if (= %{env:DELATOR_STATIC_LEVEL=trace} error))
 (libraries outcome_test_support compiler-libs.common unix))

