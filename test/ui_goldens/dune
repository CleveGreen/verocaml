(rule
 (targets
  integration_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (libraries outcome_test_support))

(rule
 (targets
  ui-semantic-outcome-cases.result-report
  ui-semantic-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  ../external_specifications/fixtures/payload.ml
  ../pure_specifications/fixtures/payload.ml
  ../specification_frontend/fixtures/invalid_empty.ml
  ../trusted_external_bodies/fixtures/missing_ensures.ml
  ../source_input/fixtures/compile_error.ml
  ../release_verification/fixtures/pure_verified.ml
  integration-library-environment.manifest)
 (action
  (run
   %{suite}
   --produce
   ui-semantic-outcome-cases.result-report
   ui-semantic-outcome-cases.failure-archive)))

(rule
 (alias ui-goldens-outcome-check)
 (deps
  (:report ui-semantic-outcome-cases.result-report)
  (:archive ui-semantic-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

(alias
 (name ui-goldens-check)
 (deps
  (alias ui-goldens-outcome-check)))

(alias
 (name runtest)
 (deps
  (alias ui-goldens-outcome-check)))
