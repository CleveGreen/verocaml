(rule
 (targets
  integration_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (libraries outcome_test_support verocaml_core unix))

(rule
 (targets
  scoped-broadcasts-outcome-cases.result-report
  scoped-broadcasts-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  (glob_files fixtures/*.ml)
  integration-library-environment.manifest)
 (action
  (run
   %{suite}
   --produce
   scoped-broadcasts-outcome-cases.result-report
   scoped-broadcasts-outcome-cases.failure-archive)))

(rule
 (alias scoped-broadcasts-outcome-check)
 (deps
  (:report scoped-broadcasts-outcome-cases.result-report)
  (:archive scoped-broadcasts-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

(alias
 (name scoped-broadcasts-check)
 (deps
  (alias runtest)))

(alias
 (name runtest)
 (deps
  (alias scoped-broadcasts-outcome-check)))
