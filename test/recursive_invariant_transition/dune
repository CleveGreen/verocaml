(executable
 (name recursive_invariant_transition_pipeline_tool)
 (modules
  recursive_invariant_transition_pipeline_tool
  recursive_invariant_transition_prerequisites)
 (flags (:standard -I src/.verocaml_core.objs/byte))
 (libraries verocaml_core))

(rule
 (targets recursive_invariant_transition_prerequisites.ml)
 (deps
  ../../src/.verocaml_core.objs/byte/symbolic_executor_private.cmi
  ../../src/.verocaml_core.objs/byte/verification_driver_private.cmi
