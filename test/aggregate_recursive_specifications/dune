(executable
 (name aggregate_recursive_specifications_tool)
 (modules
  aggregate_recursive_specifications_tool
  aggregate_recursive_specifications_prerequisites)
 (flags (:standard -I src/.verocaml_core.objs/byte))
 (libraries verocaml_core compiler-libs.common))

(rule
 (targets aggregate_recursive_specifications_prerequisites.ml)
 (deps
  ../../src/.verocaml_core.objs/byte/recursive_spec_encoding.cmi
  ../../src/.verocaml_core.objs/byte/recursive_spec_preservation.cmi
  ../../src/.verocaml_core.objs/byte/symbolic_executor_private.cmi
  ../../src/.verocaml_core.objs/byte/verification_driver_private.cmi
  ../../src/.verocaml_core.objs/byte/verification_solver_private.cmi
  ../../src/.verocaml_core.objs/byte/z3_bridge.cmi)
 (action
  (with-stdout-to %{targets} (echo "let ready = ()"))))

(rule
 (targets
  integration_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (libraries outcome_test_support verocaml_core verocaml_bin_private unix))

(rule
 (targets
  aggregate-recursive-specifications-outcome-cases.result-report
  aggregate-recursive-specifications-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  (:vstd_cmi %{lib:verocaml.vstd:vstd.cmi})
  (:vstd_int_cmt %{lib:verocaml.vstd:vstd__Int.cmt})
  (:vstd_int_cmi %{lib:verocaml.vstd:vstd__Int.cmi})
  (:vstd_int_cmti %{lib:verocaml.vstd:vstd__Int.cmti})
  (:vstd_int_vri %{lib:verocaml.vstd:vstd__Int.vri})
  (:vstd_int_manifest
   %{lib:verocaml.vstd:vstd__Int.verocaml-retained-interface})
  (glob_files fixtures/*.ml)
  integration-library-environment.manifest)
 (action
  (run
   %{suite}
   --produce
   aggregate-recursive-specifications-outcome-cases.result-report
   aggregate-recursive-specifications-outcome-cases.failure-archive)))

(rule
 (alias aggregate-recursive-specifications-outcome-check)
 (deps
  (:report aggregate-recursive-specifications-outcome-cases.result-report)
  (:archive aggregate-recursive-specifications-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

(alias
 (name aggregate-recursive-specifications-check)
 (deps (alias runtest)))

(alias
 (name runtest)
 (deps
  (alias aggregate-recursive-specifications-outcome-check)))
