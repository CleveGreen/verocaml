(executable
 (name verified_callbacks_tool)
 (modules verified_callbacks_tool verified_callbacks_prerequisites)
 (flags
  (:standard -I src/.verocaml_core.objs/byte))
 (libraries verocaml_core compiler-libs.common))

(rule
 (targets verified_callbacks_prerequisites.ml)
 (deps
