(rule
 (target value_mode_inventory.ml)
 (deps value_mode_inventory.ml.in)
 (action
  (copy %{deps} %{target})))

(executable
 (name value_mode_inventory)
 (modules value_mode_inventory value_mode_axes)
 (libraries compiler-libs.common))

(executable
 (name generate_value_mode_matrix)
 (modules generate_value_mode_matrix)
 (libraries unix))

(rule
 (targets
  integration_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (flags (:standard -opaque))
 (libraries outcome_test_support compiler-libs.common))

(rule
 (targets
  usability-p0-project-outcome-cases.result-report
  usability-p0-project-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  integration-library-environment.manifest)
 (action
  (run
   %{suite}
   --produce
   usability-p0-project-outcome-cases.result-report
   usability-p0-project-outcome-cases.failure-archive)))

(rule
 (alias usability-p0-project-outcome-check)
 (deps
  (:report usability-p0-project-outcome-cases.result-report)
  (:archive usability-p0-project-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

(alias
 (name usability-p0-project-check)
 (deps
  (alias runtest)))

(alias
 (name runtest)
 (deps
  (alias usability-p0-project-outcome-check)))
