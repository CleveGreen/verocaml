(executable
 (name symbolic_specifications_tool)
 (modules symbolic_specifications_tool symbolic_specifications_prerequisites)
 (flags (:standard -I src/.verocaml_core.objs/byte))
 (libraries verocaml_core compiler-libs.common))

(executable
 (name mutate_symbolic_carrier)
 (modules mutate_symbolic_carrier))

(executable
 (name generate_declaration_negatives)
 (modules generate_declaration_negatives))

(rule
 (targets symbolic_specifications_prerequisites.ml)
 (deps
  ../../src/.verocaml_core.objs/byte/broadcast_vc_private.cmi
  ../../src/.verocaml_core.objs/byte/solver_backend_counter_private.cmi
  ../../src/.verocaml_core.objs/byte/symbolic_application_private.cmi
  ../../src/.verocaml_core.objs/byte/symbolic_declaration_private.cmi
  ../../src/.verocaml_core.objs/byte/typedtree_symbolic_private.cmi
