  ../../src/.verocaml_core.objs/byte/vir_logic_ir_translation_private.cmi
  ../../src/.verocaml_core.objs/byte/z3_bridge.cmi)
 (action
  (with-stdout-to %{targets} (echo "let ready = ()"))))

(rule
 (targets
  integration_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (libraries outcome_test_support verocaml_core))

(rule
 (targets
  symbolic-specifications-outcome-cases.result-report
  symbolic-specifications-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  (glob_files fixtures/*.ml)
  integration-library-environment.manifest)
 (action
  (run
   %{suite}
   --produce
   symbolic-specifications-outcome-cases.result-report
   symbolic-specifications-outcome-cases.failure-archive)))

(rule
 (alias symbolic-specifications-outcome-check)
 (deps
  (:report symbolic-specifications-outcome-cases.result-report)
  (:archive symbolic-specifications-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

(cram
 (alias symbolic-specifications-specialist-check)
 (runtest_alias false)
 (deps
  generate_declaration_negatives.exe
  mutate_symbolic_carrier.exe
  (glob_files fixtures/*.ml)
  symbolic_specifications_tool.exe
  ../../verocaml.install
  ../../src/verocaml.exe
  ../../ppx/vero_ppx.exe
  ../../runtime/vero_ghost.cma
  ../../runtime/.vero_ghost.objs/byte/vero_ghost.cmi))

(alias
 (name symbolic-specifications-check)
 (deps
  (alias symbolic-specifications-outcome-check)))

(alias
 (name runtest)
 (deps
  (alias symbolic-specifications-outcome-check)))
