(executable
 (name generic_clone_dependencies_tool)
 (modules
  generic_clone_dependencies_tool
  generic_clone_dependencies_prerequisites)
 (flags
  (:standard -I src/.verocaml_core.objs/byte))
 (libraries verocaml_core compiler-libs.common))

(rule
 (targets generic_clone_dependencies_prerequisites.ml)
 (deps
  ../../src/.verocaml_core.objs/byte/finite_formal_requirement.cmi
  ../../src/.verocaml_core.objs/byte/typedtree_adapter_private.cmi
  ../../src/.verocaml_core.objs/byte/verification_identity.cmi
  ../../src/.verocaml_core.objs/byte/z3_bridge.cmi)
 (action
  (with-stdout-to
   %{targets}
   (echo "let ready = ()"))))

(rule
 (targets
  integration_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (libraries outcome_test_support verocaml_core unix))

(rule
 (targets
  generic-clone-dependencies-outcome-cases.result-report
  generic-clone-dependencies-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  (glob_files fixtures/*.ml)
  integration-library-environment.manifest)
 (action
  (run
   %{suite}
   --produce
   generic-clone-dependencies-outcome-cases.result-report
   generic-clone-dependencies-outcome-cases.failure-archive)))

(rule
 (alias generic-clone-dependencies-outcome-check)
 (deps
  (:report generic-clone-dependencies-outcome-cases.result-report)
  (:archive generic-clone-dependencies-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

(cram
 (deps
  (glob_files fixtures/*.ml)
  (glob_files fixtures/*.mli)
  generic_clone_dependencies_tool.exe
  ../../src/verocaml.exe
  ../../ppx/vero_ppx.exe
  ../../runtime/vero_ghost.cma
  ../../runtime/.vero_ghost.objs/byte/vero_ghost.cmi))

(alias
 (name generic-clone-dependency-check)
 (deps
  (alias generic-clone-dependencies-outcome-check)))

(alias
 (name runtest)
 (deps
  (alias generic-clone-dependencies-outcome-check)))
