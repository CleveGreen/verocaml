(executable
 (name recursive_rank_tool)
 (modules recursive_rank_tool recursive_rank_prerequisites)
 (flags (:standard -I src/.verocaml_core.objs/byte))
 (libraries verocaml_core ))

(rule
 (targets recursive_rank_prerequisites.ml)
 (deps
  ../../src/.verocaml_core.objs/byte/rank_encoding.cmi
  ../../src/.verocaml_core.objs/byte/z3_bridge.cmi)
 (action
  (with-stdout-to %{targets} (echo "let ready = ()"))))

(rule
 (targets
  integration_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (libraries outcome_test_support))

(rule
 (targets
  recursive-rank-outcome-cases.result-report
  recursive-rank-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  (glob_files fixtures/*.ml)
  integration-library-environment.manifest)
 (action
  (run
   %{suite}
   --produce
   recursive-rank-outcome-cases.result-report
   recursive-rank-outcome-cases.failure-archive)))

(rule
 (alias recursive-rank-outcome-check)
 (deps
  (:report recursive-rank-outcome-cases.result-report)
  (:archive recursive-rank-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

(alias
 (name recursive-rank-check)
 (deps
  (alias runtest)))

(alias
 (name runtest)
 (deps
  (alias recursive-rank-outcome-check)))
