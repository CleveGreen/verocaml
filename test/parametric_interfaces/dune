(executable
 (name parametric_interfaces_tool)
 (modules parametric_interfaces_tool parametric_interfaces_prerequisites)
 (flags
  (:standard -I src/.verocaml_core.objs/byte))
 (libraries verocaml_core compiler-libs.common unix))

(rule
 (targets parametric_interfaces_prerequisites.ml)
 (deps
  ../../src/.verocaml_core.objs/byte/imported_callable.cmi
  ../../src/.verocaml_core.objs/byte/interface_specification_environment_private.cmi
  ../../src/.verocaml_core.objs/byte/interface_specification_loaded_private.cmi
  ../../src/.verocaml_core.objs/byte/parametric_signature_private.cmi
  ../../src/.verocaml_core.objs/byte/parametric_type.cmi
  ../../src/.verocaml_core.objs/byte/solver_backend_counter_private.cmi
  ../../src/.verocaml_core.objs/byte/solver_policy_private.cmi
  ../../src/.verocaml_core.objs/byte/verification_driver_private.cmi
  ../../src/.verocaml_core.objs/byte/verification_pipeline.cmi
  ../../src/.verocaml_core.objs/byte/z3_bridge.cmi)
 (action
  (with-stdout-to
   %{targets}
   (echo "let ready = ()"))))

(rule
 (targets
  integration_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (libraries outcome_test_support verocaml_core unix))

(rule
 (targets
  parametric-interfaces-outcome-cases.result-report
  parametric-interfaces-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  (glob_files fixtures/*.ml)
  (glob_files fixtures/*.mli)
  integration-library-environment.manifest)
 (action
  (run
   %{suite}
   --produce
   parametric-interfaces-outcome-cases.result-report
   parametric-interfaces-outcome-cases.failure-archive)))

(rule
 (alias parametric-interfaces-outcome-check)
 (deps
  (:report parametric-interfaces-outcome-cases.result-report)
  (:archive parametric-interfaces-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

(alias
 (name parametric-interfaces-check)
 (deps
  (alias parametric-interfaces-outcome-check)))

(alias
 (name runtest)
 (deps
  (alias parametric-interfaces-outcome-check)))
