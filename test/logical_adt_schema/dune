(executable
 (name logical_adt_schema_tool)
 (modules logical_adt_schema_tool logical_adt_schema_prerequisites)
 (flags (:standard -I src/.verocaml_core.objs/byte))
 (libraries verocaml_core))

(rule
 (targets logical_adt_schema_prerequisites.ml)
 (deps
  ../../src/.verocaml_core.objs/byte/logical_adt_schema_private.cmi
  ../../src/.verocaml_core.objs/byte/logical_adt_encoding_private.cmi
  ../../src/.verocaml_core.objs/byte/z3_datatype_private.cmi)
 (action
  (with-stdout-to %{targets} (echo "let ready = ()"))))

(rule
 (targets
  integration_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (libraries outcome_test_support))

(rule
 (targets
  logical-adt-schema-outcome-cases.result-report
  logical-adt-schema-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  (glob_files fixtures/*.ml)
  integration-library-environment.manifest)
 (action
  (run
   %{suite}
   --produce
   logical-adt-schema-outcome-cases.result-report
   logical-adt-schema-outcome-cases.failure-archive)))

(rule
 (alias logical-adt-schema-outcome-check)
 (deps
  (:report logical-adt-schema-outcome-cases.result-report)
  (:archive logical-adt-schema-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

(alias
 (name logical-adt-schema-check)
 (deps
  (alias logical-adt-schema-outcome-check)))

(alias
 (name runtest)
 (deps
  (alias logical-adt-schema-outcome-check)))
