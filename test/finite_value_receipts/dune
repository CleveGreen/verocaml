(executable
 (name finite_value_receipts_tool)
 (modules finite_value_receipts_tool finite_value_receipts_prerequisites)
 (flags
  (:standard -I src/.verocaml_core.objs/byte))
 (libraries verocaml_core compiler-libs.common))

(rule
 (targets finite_value_receipts_prerequisites.ml)
 (deps
  ../../src/.verocaml_core.objs/byte/finite_value_registry.cmi
  ../../src/.verocaml_core.objs/byte/symbolic_executor_private.cmi
  ../../src/.verocaml_core.objs/byte/verification_pipeline.cmi
  ../../src/.verocaml_core.objs/byte/verification_session.cmi
  ../../src/.verocaml_core.objs/byte/z3_bridge.cmi)
 (action
  (with-stdout-to
   %{targets}
   (echo "let ready = ()"))))

(rule
 (targets
  integration_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (libraries outcome_test_support))

(rule
 (targets
  finite-value-receipts-outcome-cases.result-report
  finite-value-receipts-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  (glob_files fixtures/*.ml)
  integration-library-environment.manifest)
 (action
  (run
   %{suite}
   --produce
   finite-value-receipts-outcome-cases.result-report
   finite-value-receipts-outcome-cases.failure-archive)))

(rule
 (alias finite-value-receipts-outcome-check)
 (deps
  (:report finite-value-receipts-outcome-cases.result-report)
  (:archive finite-value-receipts-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

(alias
 (name finite-value-receipts-check)
 (deps
  (alias finite-value-receipts-outcome-check)))

(alias
 (name runtest)
 (deps
  (alias finite-value-receipts-outcome-check)))
