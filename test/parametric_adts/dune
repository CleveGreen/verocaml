(executable
 (name parametric_adts_tool)
 (modules parametric_adts_tool parametric_adts_prerequisites)
 (flags
  (:standard -I src/.verocaml_core.objs/byte))
 (libraries verocaml_core compiler-libs.common))

(rule
 (targets parametric_adts_prerequisites.ml)
 (deps ../../src/.verocaml_core.objs/byte/symbolic_executor_private.cmi)
 (action
  (with-stdout-to
   %{targets}
   (echo "let ready = ()"))))

(rule
 (targets
  integration_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (libraries outcome_test_support verocaml_core unix))

(rule
 (targets
  parametric-adts-outcome-cases.result-report
  parametric-adts-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  (glob_files fixtures/*.ml)
  integration-library-environment.manifest)
 (action
  (run
   %{suite}
   --produce
   parametric-adts-outcome-cases.result-report
   parametric-adts-outcome-cases.failure-archive)))

(rule
 (alias parametric-adts-outcome-check)
 (deps
  (:report parametric-adts-outcome-cases.result-report)
  (:archive parametric-adts-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

(cram
 (deps
  (glob_files fixtures/*.ml)
  parametric_adts_tool.exe
  ../../src/verocaml.exe
  ../../ppx/vero_ppx.exe
  ../../runtime/vero_ghost.cma
  ../../runtime/vero_ghost.cmxa
  ../../runtime/.vero_ghost.objs/byte/vero_ghost.cmi
  ../../runtime/.vero_ghost.objs/native/vero_ghost.cmx))

(alias
 (name parametric-adts-check)
 (deps
  (alias parametric-adts-outcome-check)))

(alias
 (name runtest)
 (deps
  (alias parametric-adts-outcome-check)))
