(executable
 (name encapsulated_recursive_mutation_tool)
 (libraries verocaml_core))

(rule
 (targets
  integration_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (libraries outcome_test_support))

(rule
 (targets
  encapsulated-recursive-mutation-outcome-cases.result-report
  encapsulated-recursive-mutation-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  (glob_files fixtures/*.ml)
  integration-library-environment.manifest)
 (action
  (run
   %{suite}
   --produce
   encapsulated-recursive-mutation-outcome-cases.result-report
   encapsulated-recursive-mutation-outcome-cases.failure-archive)))

(rule
 (alias encapsulated-recursive-mutation-outcome-check)
 (deps
  (:report encapsulated-recursive-mutation-outcome-cases.result-report)
  (:archive encapsulated-recursive-mutation-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

(cram
 (deps
  (glob_files fixtures/*.ml)
  ../type_invariant/fixtures/transition_invariant.ml
  ../type_invariant/fixtures/transition_nested_invariant.ml
  ../../ppx/vero_ppx.exe
  ../../runtime/vero_ghost.cma
  ../../runtime/.vero_ghost.objs/byte/vero_ghost.cmi
  ../../verocaml.install
  encapsulated_recursive_mutation_tool.exe))

(alias
 (name encapsulated-recursive-mutation-check)
 (deps
  (alias runtest)))

(alias
 (name runtest)
 (deps
  (alias encapsulated-recursive-mutation-outcome-check)))
