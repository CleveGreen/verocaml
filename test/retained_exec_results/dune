(executable
 (name retained_exec_results_tool)
 (modules retained_exec_results_tool retained_exec_results_prerequisites)
 (flags
  (:standard -I src/.verocaml_core.objs/byte))
 (preprocess
  (action
   (run cat %{input-file})))
 (preprocessor_deps
  ../../src/.verocaml_core.objs/byte/interface_specification.cmi
  ../../src/.verocaml_core.objs/byte/retained_exec_result_private.cmi
  ../../src/.verocaml_core.objs/byte/solver_backend_counter_private.cmi
  ../../src/.verocaml_core.objs/byte/verification_driver_private.cmi
  ../../src/.verocaml_core.objs/byte/verification_pipeline.cmi
  ../../src/.verocaml_core.objs/byte/z3_bridge.cmi)
 (libraries verocaml_core compiler-libs.common))

(rule
 (targets retained_exec_results_prerequisites.ml)
 (deps
  ../../src/.verocaml_core.objs/byte/interface_specification.cmi
  ../../src/.verocaml_core.objs/byte/retained_exec_result_private.cmi
