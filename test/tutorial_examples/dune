(rule
 (targets
  integration_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (libraries outcome_test_support))

(rule
 (targets
  tutorial-examples-outcome-cases.result-report
  tutorial-examples-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  integration-library-environment.manifest
  fixtures/failed-proof.ml
  ../../examples/tutorial/01-contracts.ml
  ../../examples/tutorial/02-recursive-specification.ml
  ../../examples/tutorial/03-scalar-induction.ml
  ../../examples/tutorial/04-list-induction.ml
  ../../examples/tutorial/05-tree-induction.ml
  ../../examples/tutorial/06-finite-formals.ml
  ../../examples/tutorial/07-owned-recursive-stack.ml
  ../../examples/tutorial/08-abstract-nested-mutation.ml)
 (action
  (run
   %{suite}
   --produce
   tutorial-examples-outcome-cases.result-report
   tutorial-examples-outcome-cases.failure-archive)))

(rule
 (alias tutorial-examples-outcome-check)
 (deps
  (:report tutorial-examples-outcome-cases.result-report)
  (:archive tutorial-examples-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

(cram
 (applies_to tutorial_examples)
 (alias tutorial-examples-specialist-check)
 (runtest_alias false)
 (deps
  manifest.txt
  fixtures/failed-proof.ml
  ../../docs/TUTORIAL.org
  ../../examples/tutorial/01-contracts.ml
  ../../examples/tutorial/02-recursive-specification.ml
  ../../examples/tutorial/03-scalar-induction.ml
  ../../examples/tutorial/04-list-induction.ml
  ../../examples/tutorial/05-tree-induction.ml
  ../../examples/tutorial/06-finite-formals.ml
  ../../examples/tutorial/07-owned-recursive-stack.ml
  ../../examples/tutorial/08-abstract-nested-mutation.ml
  ../../ppx/vero_ppx.exe))

(alias
 (name tutorial-examples-check)
 (deps (alias tutorial-examples-outcome-check)))

(alias
 (name runtest)
 (deps (alias tutorial-examples-outcome-check)))
