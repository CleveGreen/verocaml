(executable
 (name shared_scalar_heap_tool)
 (modules
  shared_scalar_heap_tool
  shared_scalar_heap_prerequisites)
 (flags (:standard -I src/.verocaml_core.objs/byte))
 (libraries verocaml_core compiler-libs.common))

(rule
 (targets shared_scalar_heap_prerequisites.ml)
 (deps
  ../../src/.verocaml_core.objs/byte/shared_scalar_heap_private.cmi
  ../../src/.verocaml_core.objs/byte/vir_integer_conditional_private.cmi
  ../../src/.verocaml_core.objs/byte/symbolic_executor_private.cmi
  ../../src/.verocaml_core.objs/byte/verification_driver_private.cmi
  ../../src/.verocaml_core.objs/byte/verification_pipeline.cmi
  ../../src/.verocaml_core.objs/byte/verification_session.cmi
  ../../src/.verocaml_core.objs/byte/recursive_spec_encoding.cmi
  ../../src/.verocaml_core.objs/byte/solver_backend.cmi
  ../../src/.verocaml_core.objs/byte/z3_bridge.cmi)
 (action
  (with-stdout-to %{targets} (echo "let ready = ()"))))

(rule
 (targets
  integration_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (libraries outcome_test_support))

(rule
 (targets
  shared-scalar-heap-outcome-cases.result-report
  shared-scalar-heap-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  (glob_files fixtures/*.ml)
  integration-library-environment.manifest)
 (action
  (run
   %{suite}
   --produce
   shared-scalar-heap-outcome-cases.result-report
   shared-scalar-heap-outcome-cases.failure-archive)))

(rule
 (alias shared-scalar-heap-outcome-check)
 (deps
  (:report shared-scalar-heap-outcome-cases.result-report)
  (:archive shared-scalar-heap-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

(cram
 (deps
  (glob_files fixtures/*.ml)
  shared_scalar_heap_tool.exe
  ../../verocaml.install
  ../../src/verocaml.exe
  ../../ppx/vero_ppx.exe
  ../../runtime/vero_ghost.cma
  ../../runtime/.vero_ghost.objs/byte/vero_ghost.cmi))

(alias
 (name shared-scalar-heap-check)
 (deps
  (alias runtest)))

(alias
 (name runtest)
 (deps
  (alias shared-scalar-heap-outcome-check)))
