(executable
 (name recursive_specifications_tool)
 (modules recursive_specifications_tool recursive_specifications_prerequisites)
 (flags (:standard -I src/.verocaml_core.objs/byte))
 (libraries verocaml_core  compiler-libs.common))

(rule
 (targets recursive_specifications_prerequisites.ml)
 (deps
  ../../src/.verocaml_core.objs/byte/recursive_spec_encoding.cmi
  ../../src/.verocaml_core.objs/byte/z3_bridge.cmi)
 (action
  (with-stdout-to %{targets} (echo "let ready = ()"))))

(rule
 (target verocaml-install-root)
 (deps
  (alias_rec %{project_root}/install)
  (sandbox none))
 (action
  (with-stdout-to %{target}
   (bash "printf '%s/install/default\\n' \"$(cd ../../.. && pwd)\""))))

(rule
 (targets
  integration_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (libraries outcome_test_support))

(rule
 (targets
  recursive-specifications-outcome-cases.result-report
  recursive-specifications-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  (glob_files fixtures/*.ml)
  integration-library-environment.manifest)
 (action
  (run
   %{suite}
   --produce
   recursive-specifications-outcome-cases.result-report
   recursive-specifications-outcome-cases.failure-archive)))

(rule
 (alias recursive-specifications-outcome-check)
 (deps
  (:report recursive-specifications-outcome-cases.result-report)
  (:archive recursive-specifications-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))
(alias
 (name recursive-specifications-check)
 (deps
  (alias runtest)))
(alias
 (name structural-recursion-check)
 (deps
  (alias runtest)))

(alias
 (name runtest)
 (deps
  (alias recursive-specifications-outcome-check)))
