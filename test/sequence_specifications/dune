(rule
 (targets
  integration_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (libraries outcome_test_support))

(rule
 (targets
  sequence-specifications-outcome-cases.result-report
  sequence-specifications-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  integration-library-environment.manifest
  ../../library/seq.ml
  fixtures/positive_client.ml
  fixtures/negative_invalid_client.ml)
 (action
  (run
   %{suite}
   --produce
   sequence-specifications-outcome-cases.result-report
   sequence-specifications-outcome-cases.failure-archive)))

(rule
 (alias sequence-specifications-outcome-check)
 (deps
  (:report sequence-specifications-outcome-cases.result-report)
  (:archive sequence-specifications-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

(cram
 (applies_to sequence_specifications)
 (alias sequence-specifications-specialist-check)
 (runtest_alias false)
 (deps
  (glob_files fixtures/*.ml)
  ../../library/seq.ml
  ../../library/seq.mli
  ../../src/verocaml.exe
  ../../ppx/vero_ppx.exe
  ../../runtime/vero_ghost.cma
  ../../runtime/.vero_ghost.objs/byte/vero_ghost.cmi))

(alias
 (name sequence-specifications-check)
 (deps
  (alias sequence-specifications-outcome-check)))

(alias
 (name runtest)
 (deps
  (alias sequence-specifications-outcome-check)))
