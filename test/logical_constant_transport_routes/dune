(rule
 (targets
  integration_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (flags (:standard -opaque -I src/.verocaml_core.objs/byte))
 (libraries outcome_test_support verocaml_core compiler-libs.common unix))

(rule
 (targets
  logical-constant-transport-routes-outcome-cases.result-report
  logical-constant-transport-routes-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  integration-library-environment.manifest)
 (action
  (run
   %{suite}
   --produce
   logical-constant-transport-routes-outcome-cases.result-report
   logical-constant-transport-routes-outcome-cases.failure-archive)))

(rule
 (alias logical-constant-transport-routes-outcome-check)
 (deps
  (:report logical-constant-transport-routes-outcome-cases.result-report)
  (:archive logical-constant-transport-routes-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

(alias
 (name runtest)
 (deps (alias logical-constant-transport-routes-outcome-check)))
