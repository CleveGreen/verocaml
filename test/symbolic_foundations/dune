  compiler-libs.common
  delator
  unix))

(rule
 (targets
  symbolic-foundations-outcome-cases.result-report
  symbolic-foundations-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  integration-library-environment.manifest)
 (action
  (run
   %{suite}
   --produce
   symbolic-foundations-outcome-cases.result-report
   symbolic-foundations-outcome-cases.failure-archive)))

(rule
 (alias symbolic-foundations-outcome-check)
 (deps
  (:report symbolic-foundations-outcome-cases.result-report)
  (:archive symbolic-foundations-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

(alias
 (name runtest)
 (deps (alias symbolic-foundations-outcome-check)))
