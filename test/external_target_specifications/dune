(executable
 (name external_target_specifications_tool)
 (modules external_target_specifications_tool)
 (flags
  (:standard -I src/.verocaml_core.objs/byte))
 (preprocess
  (action
   (run cat %{input-file})))
 (preprocessor_deps
  ../../src/.verocaml_core.objs/byte/external_target_specification_private.cmi
  ../../src/.verocaml_core.objs/byte/interface_specification_loaded_private.cmi
  ../../src/.verocaml_core.objs/byte/sst_validation_private.cmi
  ../../src/.verocaml_core.objs/byte/verification_driver_private.cmi)
 (libraries verocaml_core compiler-libs.common))

(rule
 (targets
  integration_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (libraries outcome_test_support))

(rule
 (targets
  external-target-specifications-outcome-cases.result-report
  external-target-specifications-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  (glob_files fixtures/*)
  integration-library-environment.manifest)
 (action
  (run
   %{suite}
   --produce
   external-target-specifications-outcome-cases.result-report
   external-target-specifications-outcome-cases.failure-archive)))

(rule
 (alias external-target-specifications-outcome-check)
 (deps
  (:report external-target-specifications-outcome-cases.result-report)
  (:archive external-target-specifications-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

