(executable
 (name recursive_aggregates_tool)
 (libraries smtml verocaml_core))

(rule
 (targets
  integration_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (libraries outcome_test_support))

(rule
 (targets
  recursive-aggregates-outcome-cases.result-report
  recursive-aggregates-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  (glob_files fixtures/*.ml)
  integration-library-environment.manifest)
 (action
  (run
   %{suite}
   --produce
   recursive-aggregates-outcome-cases.result-report
   recursive-aggregates-outcome-cases.failure-archive)))

(rule
 (alias recursive-aggregates-outcome-check)
 (deps
  (:report recursive-aggregates-outcome-cases.result-report)
  (:archive recursive-aggregates-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

(cram
 (deps
  (glob_files fixtures/*.ml)
  recursive_aggregates_tool.exe
  ../../ppx/vero_ppx.exe
  ../../runtime/vero_ghost.cma
  ../../runtime/.vero_ghost.objs/byte/vero_ghost.cmi))

(alias
 (name recursive-aggregates-check)
 (deps
  (alias runtest)))

(alias
 (name runtest)
 (deps
  (alias recursive-aggregates-outcome-check)))
