  ../../src/.verocaml_core.objs/byte/z3_bridge.cmi
  ../../runtime/.vero_ghost.objs/byte/vero_ghost.cmi)
 (action
  (with-stdout-to %{targets} (echo "let ready = ()"))))

(rule
 (targets
  integration_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (libraries outcome_test_support))

(rule
 (targets
  shared-recursive-frozen-spine-outcome-cases.result-report
  shared-recursive-frozen-spine-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  (glob_files fixtures/*.ml)
  integration-library-environment.manifest)
 (action
  (run
   %{suite}
   --produce
   shared-recursive-frozen-spine-outcome-cases.result-report
   shared-recursive-frozen-spine-outcome-cases.failure-archive)))

(rule
 (alias shared-recursive-frozen-spine-outcome-check)
 (deps
  (:report shared-recursive-frozen-spine-outcome-cases.result-report)
  (:archive shared-recursive-frozen-spine-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

(alias
 (name shared-recursive-frozen-spine-check)
 (deps (alias runtest)))

(alias
 (name runtest)
 (deps
  (alias shared-recursive-frozen-spine-outcome-check)))
