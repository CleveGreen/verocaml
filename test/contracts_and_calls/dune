(executable
 (name contracts_and_calls_tool)
 (modules contracts_and_calls_tool)
 (libraries verocaml_core))

(rule
 (targets
  integration_environment.ml
  integration-library-environment.manifest)
 (deps
  (:environment_module ../outcome_framework/integration_environment.ml)
  (:manifest ../outcome_framework/integration-library-environment.manifest))
 (action
  (progn
   (copy %{environment_module} integration_environment.ml)
   (copy %{manifest} integration-library-environment.manifest))))

(executable
 (name outcome_cases)
 (modules outcome_cases integration_environment)
 (libraries outcome_test_support verocaml_core))

(rule
 (targets
  contracts-and-calls-outcome-cases.result-report
  contracts-and-calls-outcome-cases.failure-archive)
 (deps
  (sandbox always)
  (:suite outcome_cases.exe)
  integration-library-environment.manifest)
 (action
  (run
   %{suite}
   --produce
   contracts-and-calls-outcome-cases.result-report
   contracts-and-calls-outcome-cases.failure-archive)))

(rule
 (alias contracts-and-calls-outcome-check)
 (deps
  (:report contracts-and-calls-outcome-cases.result-report)
  (:archive contracts-and-calls-outcome-cases.failure-archive)
  (:validator ../support/report_validator.exe))
 (action
  (run %{validator} %{report} %{archive})))

(cram
 (deps
  (glob_files fixtures/*.ml)
  contracts_and_calls_tool.exe
  ../../ppx/vero_ppx.exe
  ../../runtime/vero_ghost.cma
  ../../runtime/.vero_ghost.objs/byte/vero_ghost.cmi))

(alias
 (name contracts-and-calls-check)
 (deps
  (alias runtest)))

(alias
 (name runtest)
 (deps
  (alias contracts-and-calls-outcome-check)))
