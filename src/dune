(executable
 (name trusted_import_generator)
 (modules trusted_import_generator)
 (libraries compiler-libs.common))

(rule
 (targets trusted_imports.ml)
 (deps
  (:stdlib %{ocaml_where}/stdlib.cmi)
  (:effect %{ocaml_where}/stdlib__Effect.cmi)
  (:domain %{ocaml_where}/stdlib__Domain.cmi)
  (:ghost %{lib:verocaml.ghost:vero_ghost.cmi}))
 (action
  (run
   %{exe:trusted_import_generator.exe}
   %{stdlib}
   %{effect}
   %{domain}
   %{ghost}
   %{targets})))

