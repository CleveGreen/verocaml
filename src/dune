(executable
 (name trusted_import_generator)
 (modules trusted_import_generator)
 (libraries compiler-libs.common))

(rule
 (targets trusted_imports.ml)
 (deps
  (:stdlib %{ocaml_where}/stdlib.cmi)
  (:effect %{ocaml_where}/stdlib__Effect.cmi)
  (:domain %{ocaml_where}/stdlib__Domain.cmi)
  (:ghost %{lib:verocaml.ghost:vero_ghost.cmi}))
 (action
  (run
   %{exe:trusted_import_generator.exe}
   %{stdlib}
   %{effect}
   %{domain}
   %{ghost}
   %{targets})))

(executable
 (name numeric_build_target_generator)
 (modules numeric_build_target_generator))

(executable
 (name bv_backend_capability_generator)
 (modules bv_backend_capability_generator))

(rule
 (targets bv_backend_capability_generated.ml)
 (action
  (with-stdout-to
   %{targets}
   (run
    %{exe:bv_backend_capability_generator.exe}
    --issuer
    official-verocaml-verifier-build
    --build-input-schema
    verocaml.bv-build-inputs.v1
    --z3-package
    z3.4.15.2+verocaml.1
    --z3-portability-patch-sha256
    7d4f99c060b72154d3fc9948226191e95a721c0c8d8d8110b385f480610ea071
    --maximum-bv-width
    4096))))

(rule
 (targets numeric_build_target_generated.ml)
 (action
  (with-stdout-to
   %{targets}
   (run
    %{exe:numeric_build_target_generator.exe}
    --profile
    verocaml-portable-word-matrix-v1
    --logical-bv-widths
    positive
    --layout
    portable-word-layout
    portable-word-layout-32-v1
    32
    true
    --layout
    portable-word-layout
    portable-word-layout-64-v1
    64
    true))))

