opam-version: "2.0"
synopsis: "A verification prototype for an OxCaml subset"
description: """
verocaml is a verification prototype for an OxCaml subset.
"""
maintainer: "verocaml contributors"
authors: "verocaml contributors"
license: "MIT"
homepage: "https://github.com/CleveGreen/verocaml"
bug-reports: "https://github.com/CleveGreen/verocaml/issues"
depends: [
  "ocaml" {= "5.2.0"}
  "dune" {>= "3.17"}
  "smtml" {= "0.25.0"}
  "zarith" {= "1.14"}
  "parallel" {= "v0.18~preview.130.83+317+verocaml.1"}
  "delator"
  "yojson"
  "ppxlib" {>= "0.33.0"}
  "z3" {= "4.15.2+verocaml.1"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
